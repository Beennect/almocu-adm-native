{
  "expo": {
    "name": "almocu-native",
    "slug": "almocu-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "unstable_useServerMiddleware": true
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "API_URL": "https://url",
      "AUTH_PORT": "0000",
      "MENU_PORT": "0000",
      "STOCK_PORT": "0000",
      "ORDER_PORT": "0000"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
